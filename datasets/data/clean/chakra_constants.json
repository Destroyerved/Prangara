  "leak_detection_thresholds": {
    "benchmark_breach": {
      "trigger": "stream_intensity > sector_p75",
      "severity_formula": "min(1.0, over / 0.5) * stream_share + 0.15_floor"
    },
    "material_concentration": {
      "trigger": "stream_share > 0.15 AND stream_intensity > sector_p50",
      "severity_formula": "(distance_above_p50 / p50) * stream_share"
    },
    "structural_hotspot": {
      "trigger": "stream_share > 0.25 AND no_applicable_benchmark",
      "severity_formula": "(stream_share - 0.25) / 0.75"
    },
    "severity_bands": {
      "critical": ">= 0.60",
      "high": ">= 0.35",
      "moderate": ">= 0.15",
      "watch": "< 0.15"
    }
  },
  "economic_formulas": {
    "capital_recovery_factor": "r * (1 + r)^n / ((1 + r)^n - 1)",
    "annualised_capex": "CRF * capex",
    "lcoa_inr_per_tco2e": "(annualised_capex + delta_opex - gross_saving) / annual_abatement",
    "simple_payback_years": "capex / (gross_saving - delta_opex)",
    "gap_to_median_tonnes": "stream_tco2e * (actual_intensity - p50_intensity) / actual_intensity",
    "size_multiplier_revenue": {
