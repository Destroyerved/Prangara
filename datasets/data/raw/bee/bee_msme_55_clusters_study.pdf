<style>
    .bg-brand-dark {
        background-color: #212121 !important;
    }
    
    .bg-brand-light {
        background-color: #2a2a2a !important;
    }

    .custom-pill {
        border-color: #fff !important;
        transition: background-color 0.2s, color 0.2s;
    }
    
    .custom-pill:hover {
        background-color: #2a2a2a!important;
        color: #ffffff !important;
    }

    .ticker-container {
        overflow: hidden;
        white-space: nowrap;
        display: flex;
        width: 100%;
    }

    .ticker-track {
        display: flex;
        gap: 2rem;
        padding-left: 100%;
        animation: marquee 120s linear infinite;
    }
    
    .ticker-track:hover {
        animation-play-state: paused;
    }

    .ticker-track.paused {
        animation-play-state: paused !important;
    }

    .announcement-links i {
        color: #ffffff !important;
    }

    .gov-icons-container {
        overflow: hidden;
        width: 100%;
    }

    .gov-icons-track {
        display: flex;
        gap: 1.5rem;
        padding-left: 100%;
        animation: gov-marquee 120s linear infinite;
        align-items: center;
    }

    .gov-icons-track li {
        list-style: none;
    }

    .gov-icons-track:hover,
    .gov-icons-track.paused {
        animation-play-state: paused !important;
    }

    @keyframes gov-marquee {
        0% {
            transform: translate3d(0, 0, 0);
        }
        100% {
            transform: translate3d(-100%, 0, 0);
        }
    }

    @keyframes marquee {
        0% {
            transform: translate3d(0, 0, 0);
        }
        100% {
            transform: translate3d(-100%, 0, 0);
        }
    }

    @media (min-width: 768px) {
        .min-w-md-140 {
            min-width: 140px;
        }
    }
</style>



                
