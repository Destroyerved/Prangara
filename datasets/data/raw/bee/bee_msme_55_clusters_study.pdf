  <script>
    const track = document.getElementById('ticker-track');
    const toggleBtn = document.getElementById('btn-toggle');

    toggleBtn.addEventListener('click', () => {
        const isPaused = track.classList.toggle('paused');
        if (isPaused) {
            toggleBtn.innerHTML = '<i class="bi bi-play-fill"></i>'; 
            toggleBtn.setAttribute('aria-label', 'Play');
        } else {
            toggleBtn.innerHTML = '<i class="bi bi-pause-fill"></i>';
            toggleBtn.setAttribute('aria-label', 'Pause');
        }
    });
  </script>

<script>
    const govTrack = document.getElementById('gov-track');
    const govToggleBtn = document.getElementById('gov-btn-toggle');

    if (govToggleBtn && govTrack) {
        govToggleBtn.addEventListener('click', () => {
            const isPaused = govTrack.classList.toggle('paused');
            if (isPaused) {
                govToggleBtn.innerHTML = '<i class="bi bi-play-fill"></i>';
                govToggleBtn.setAttribute('aria-label', 'Play');
            } else {
                govToggleBtn.innerHTML = '<i class="bi bi-pause-fill"></i>';
                govToggleBtn.setAttribute('aria-label', 'Pause');
            }
        });
    }
</script>

