# PRANGARA environment. Copy to .env and fill in. Never commit a real .env.

APP_ENV=development

# --- frontend (web dashboard) ---------------------------------------------
# demo is the default. Set api only after connecting backend.
VITE_DATA_MODE=demo
VITE_API_BASE_URL=/api
API_PROXY_TARGET=http://127.0.0.1:8000

# --- database -------------------------------------------------------------
# Default when unset is a local SQLite file (backend/prangara.db), which needs
# no services running. PostgreSQL is required for PostGIS (logistics) and
# pgvector (RAG).
# DATABASE_URL=postgresql+psycopg://prangara:prangara@localhost:5432/prangara
DATABASE_URL=
SQL_ECHO=false

# --- auth -----------------------------------------------------------------
# Required whenever APP_ENV is not "development". Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

# --- evidence storage ------------------------------------------------------
# local | minio
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=prangara-evidence
MINIO_SECURE=false
MAX_UPLOAD_MB=25

# --- AI intake (optional) --------------------------------------------------
# When unset, conversational onboarding falls back to a deterministic parser and
# says so; it does not fabricate an extraction.
OLLAMA_BASE_URL=
OLLAMA_MODEL=
EMBEDDING_MODEL=

# --- logistics (BE-2) ------------------------------------------------------
OSRM_BASE_URL=

# --- platform tuning -------------------------------------------------------
# Minimum peer cohort before a benchmark is blended with measured data at all.
BENCHMARK_MIN_COHORT=3

# --- clients ---------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8081,http://localhost:19006

# Read by apps/mobile at build time (Expo). Use the LAN IP of the machine
# running the API when testing on a physical Android device - localhost on the
# phone is the phone.
EXPO_PUBLIC_API_URL=http://localhost:8000

# --- auth rate limiting (PRD section 28) ---
# In-process fixed windows. Set false for load testing.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_ACCOUNT=8
RATE_LIMIT_LOGIN_PER_IP=30
RATE_LIMIT_REGISTER_PER_IP=10
RATE_LIMIT_REFRESH_PER_IP=60
RATE_LIMIT_WINDOW_SECONDS=300
