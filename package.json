{
  "name": "prangara-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost --port 5173 --strictPort",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "lint": "eslint .",
    "test": "vitest run --exclude \"work/**\" --exclude \"apps/**\"",
    "test:ml": "node backend-node/tests/test_ml_backend.js && node backend-node/tests/test_server_live.js",
    "test:datasets": "node datasets/08_automated_test_suites/test_chakra_invariants.js && node datasets/08_automated_test_suites/verify_dataset_authenticity.js",
    "test:motion": "node test-motion.mjs && node verify.mjs",
    "test:all": "npm run test && npm run test:ml && npm run test:datasets && npm run test:motion"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-table": "8.21.3",
    "@types/three": "^0.186.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "7.9.0",
    "d3-sankey": "0.12.3",
    "firebase": "^12.19.0",
    "framer-motion": "^13.2.0",
    "lenis": "^1.3.26",
    "lucide-react": "1.45.0",
    "motion": "13.2.0",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.3",
    "tailwind-merge": "^3.6.0",
    "three": "^0.186.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/d3": "7.4.3",
    "@types/d3-sankey": "0.12.5",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.1.2",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "playwright": "^1.63.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
